{
  "name": "patchwork-pirates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "sprites": "pnpm --filter @patchwork/spritegen spritegen",
    "sprites:prompt": "pnpm --filter @patchwork/spritegen spritegen prompt",
    "sprites:normalize": "pnpm --filter @patchwork/spritegen spritegen normalize",
    "sprites:check": "pnpm --filter @patchwork/spritegen spritegen check",
    "sprites:atlas": "pnpm --filter @patchwork/spritegen spritegen atlas",
    "sprites:review": "pnpm --filter @patchwork/spritegen spritegen contact-sheet"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
